# Shared database and JWT configuration (must match the existing services)
DB_URL=postgresql://...
JWT_SEC=replace_with_the_same_secret_used_by_auth_user_and_job_services

# Razorpay Test Mode credentials from Razorpay Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Set this after adding the webhook endpoint in Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=...

# Payment service port
PORT=4004
